# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=407565414701334528
OWNER_ID=

# ── Structural roles (required: Guest, Friend) ────────────────────────────────
GUEST_ROLE_ID=
FRIEND_ROLE_ID=
MOD_ROLE_ID=
ADMIN_ROLE_ID=

# ── Rating roles (optional — leave blank to skip that tier) ────────────────────
ROLE_UNRANKED_ID=
ROLE_1400_ID=
ROLE_1800_ID=
ROLE_2100_ID=
ROLE_GLADIATOR_ID=
ROLE_MERCILESS_ID=

# ── Channels ──────────────────────────────────────────────────────────────────
# Always use IDs, never names: a rename or a category move changes the name but
# never the ID. Enable Developer Mode in Discord, right-click a channel → Copy ID.
VERIFY_CHANNEL_ID=
VOICE_CATEGORY_ID=
# Welcome (intro + verify panel) and rules. Blank = fall back to channels named
# #welcome / #rules. Run /welcome here in a channel to get its ID.
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
# Audit log target. Blank = fall back to a channel named #bot-logs.
LOG_CHANNEL_ID=

# ── Behavior ──────────────────────────────────────────────────────────────────
GUEST_EXPIRATION_DAYS=30
VERIFY_TIMEOUT_HOURS=24
# Keep false on an existing server. When true, the bot kicks members who never
# verified (no Guest role) after VERIFY_TIMEOUT_HOURS. Only enable once the
# verify gate is set up, or it will remove members who predate the bot.
ENFORCE_VERIFICATION=false
CACHE_REFRESH_MINUTES=60
# Auto-create/resolve class & spec roles by name (true/false)
MANAGE_CLASS_SPEC_ROLES=true

# ── Ironforge ─────────────────────────────────────────────────────────────────
IRONFORGE_BASE=https://ironforge.pro
CURRENT_SEASON=2
REGION=US

# ── Blizzard fallback (optional) ──────────────────────────────────────────────
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# ── Twitch "now live" notifications (optional) ────────────────────────────────
# Create an app at https://dev.twitch.tv/console/apps to get the id/secret.
# Leave blank to disable the feature entirely.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Comma-separated Twitch usernames to watch, e.g. hilzftw,somefriend
TWITCH_STREAMERS=
# Optional: channel to post in (defaults to a channel named twitchy-p-clips)
TWITCH_CHANNEL_ID=
TWITCH_POLL_MINUTES=3

# ── WoW News module ───────────────────────────────────────────────────────────
# Auto-posts filtered TBC-PvP / TBC-PvE / Retail news. All three categories go to
# the single merged channel below; each embed keeps its own emoji + category label.
NEWS_ENABLED=true
NEWS_POLL_MINUTES=20
# The merged news channel ID. If blank, the bot falls back to the legacy trio
# (#tbc-pvp-news / #tbc-pve-news / #retail-wow-news) resolved by name.
# Can also be set live with /news channel — the DB value wins over this.
NEWS_CHANNEL_ID=1523684148407959737
# Max articles posted per poll. Stops a backlog from flooding the channel after
# downtime; the overflow is marked seen and skipped.
NEWS_MAX_PER_RUN=8
# Which categories actually post. TBC Classic only by default — retail is still
# classified (so it can never misroute into a TBC embed) but is dropped, not posted.
# To turn retail back on: NEWS_CATEGORIES=tbc-pvp,tbc-pve,retail
NEWS_CATEGORIES=tbc-pvp,tbc-pve

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=bot.db
