# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=407565414701334528
OWNER_ID=

# ── Structural roles (required: Guest, Friend) ────────────────────────────────
GUEST_ROLE_ID=
FRIEND_ROLE_ID=
MOD_ROLE_ID=
ADMIN_ROLE_ID=

# ── Rating roles (optional — leave blank to skip that tier) ────────────────────
ROLE_UNRANKED_ID=
ROLE_1400_ID=
ROLE_1800_ID=
ROLE_2100_ID=
ROLE_GLADIATOR_ID=
ROLE_MERCILESS_ID=

# ── Channels ──────────────────────────────────────────────────────────────────
VERIFY_CHANNEL_ID=
CHANNEL_2V2_ID=
CHANNEL_3V3_ID=
CHANNEL_5V5_ID=
VOICE_CATEGORY_ID=

# ── Behavior ──────────────────────────────────────────────────────────────────
GUEST_EXPIRATION_DAYS=30
VERIFY_TIMEOUT_HOURS=24
# Keep false on an existing server. When true, the bot kicks members who never
# verified (no Guest role) after VERIFY_TIMEOUT_HOURS. Only enable once the
# verify gate is set up, or it will remove members who predate the bot.
ENFORCE_VERIFICATION=false
QUEUE_EXPIRY_MINUTES=30
CACHE_REFRESH_MINUTES=60
# Auto-create/resolve class & spec roles by name (true/false)
MANAGE_CLASS_SPEC_ROLES=true

# ── Ironforge ─────────────────────────────────────────────────────────────────
IRONFORGE_BASE=https://ironforge.pro
CURRENT_SEASON=2
REGION=US

# ── Blizzard fallback (optional) ──────────────────────────────────────────────
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# ── Twitch "now live" notifications (optional) ────────────────────────────────
# Create an app at https://dev.twitch.tv/console/apps to get the id/secret.
# Leave blank to disable the feature entirely.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Comma-separated Twitch usernames to watch, e.g. hilzftw,somefriend
TWITCH_STREAMERS=
# Optional: channel to post in (defaults to a channel named twitchy-p-clips)
TWITCH_CHANNEL_ID=
TWITCH_POLL_MINUTES=3

# ── WoW News module ───────────────────────────────────────────────────────────
# Auto-posts filtered TBC-PvP / TBC-PvE / Retail news to the NEWS channels.
NEWS_ENABLED=true
NEWS_POLL_MINUTES=20

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=bot.db
